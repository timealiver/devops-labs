{
 "uid": "shop-sla",
 "title": "shop — SLA под нагрузкой",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "5s",
 "time": {
  "from": "now-15m",
  "to": "now"
 },
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "SLA: p95 оформления заказа (порог 300 мс)",
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.95, sum by (le) (rate(shop_api_request_duration_seconds_bucket{path=\"/order\"}[1m])))",
     "legendFormat": "p95 /order"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 15,
      "spanNulls": true,
      "thresholdsStyle": {
       "mode": "line"
      }
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 0.3
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "Заказы: RPS и ошибки",
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(shop_api_requests_total{path=\"/order\"}[1m]))",
     "legendFormat": "заказов/с"
    },
    {
     "refId": "B",
     "expr": "sum(rate(shop_api_requests_total{path=\"/order\",status=~\"5..\"}[1m]))",
     "legendFormat": "ошибок/с"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 15,
      "spanNulls": true
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "Поды shop по фазам",
   "gridPos": {
    "x": 0,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (phase) (kube_pod_status_phase{namespace=\"shop\"})",
     "legendFormat": "{{phase}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 15,
      "spanNulls": true
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "id": 4,
   "type": "timeseries",
   "title": "Реплики: нужно и живых",
   "gridPos": {
    "x": 12,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "kube_deployment_spec_replicas{namespace=\"shop\",deployment=~\"shop-api|shop-batch\"}",
     "legendFormat": "{{deployment}} нужно"
    },
    {
     "refId": "B",
     "expr": "kube_deployment_status_replicas_available{namespace=\"shop\",deployment=~\"shop-api|shop-batch\"}",
     "legendFormat": "{{deployment}} живых"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 15,
      "spanNulls": true
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "Вытесненные поды (Evicted)",
   "gridPos": {
    "x": 0,
    "y": 16,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(kube_pod_status_reason{namespace=\"shop\",reason=\"Evicted\"})",
     "legendFormat": "Evicted"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 15,
      "spanNulls": true
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "Память подов shop (working set)",
   "gridPos": {
    "x": 12,
    "y": 16,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (pod) (container_memory_working_set_bytes{namespace=\"shop\",container!=\"\",pod=~\"shop-(api|batch).*\"})",
     "legendFormat": "{{pod}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "bytes",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 15,
      "spanNulls": true
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  }
 ]
}